{
  "name": "Focus Triad — Your personal life tracker",
  "short_name": "Focus Triad",
  "description": "Focus Triad tracks what matters to you — workouts, work time, personal projects, sleep, water, and meals — as a clear daily timeline with habit streaks, weekly reviews, and a grounded chat.",
